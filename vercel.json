{
  "functions": {
    "app/api/**": {
      "runtime": "nodejs20.x"
    }
  },
  "buildCommand": "npm run build && npm run postinstall",
  "outputDirectory": ".next",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
